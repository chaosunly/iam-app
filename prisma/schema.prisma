generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  groups      Group[]

  @@map("organizations")
}

model Group {
  id             String       @id
  organizationId String       @map("organization_id")
  name           String
  description    String?
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("groups")
}

// GitLab Access Management Models
model GitlabGroup {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  projects    GitlabProject[]

  @@map("gitlab_groups")
}

model GitlabProject {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  groupId     String?       @map("group_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  group       GitlabGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId])
  @@map("gitlab_projects")
}

model GitlabRoleAssignment {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  resourceType String   @map("resource_type") // "group" or "project"
  resourceId   String   @map("resource_id")
  role         String   // "owner", "maintainer", "developer", "reporter", "guest"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("gitlab_role_assignments")
}

// ─── Matrix Access Management Models ──────────────────────────────────────────

model MatrixOrg {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  homeserver  String?                                    // e.g. "matrix.acme.corp"
  iamOrgId    String?       @unique @map("iam_org_id")  // links to Organization.id
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  spaces      MatrixSpace[]

  @@map("matrix_orgs")
}

model MatrixSpace {
  id          String       @id @default(cuid())
  name        String
  description String?
  matrixId    String?      @map("matrix_id")  // Element internal space ID (!abc:matrix.org)
  orgId       String       @map("org_id")
  org         MatrixOrg    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  rooms       MatrixRoom[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("matrix_spaces")
}

model MatrixRoom {
  id          String      @id @default(cuid())
  name        String
  description String?
  matrixId    String?     @map("matrix_id")               // Element internal room ID (!xyz:matrix.org)
  roomType    String      @default("general") @map("room_type")  // "group" | "general"
  iamGroupId  String?     @unique @map("iam_group_id")    // links to Group.id (group rooms only)
  spaceId     String      @map("space_id")
  space       MatrixSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@unique([spaceId, name])
  @@index([spaceId])
  @@map("matrix_rooms")
}

model MatrixRoleAssignment {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  resourceType String   @map("resource_type")  // "org" | "space" | "room"
  resourceId   String   @map("resource_id")
  role         String   // "matrix_admin" | "moderator" | "support" | "member" | "viewer"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("matrix_role_assignments")
}

model MatrixDirectMessage {
  id           String   @id @default(cuid())
  initiatorId  String   @map("initiator_id")
  recipientId  String   @map("recipient_id")
  matrixRoomId String?  @map("matrix_room_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([initiatorId, recipientId])
  @@index([initiatorId])
  @@map("matrix_direct_messages")
}

/// Links a Kratos identity (IAM userId) to its Matrix account.
/// Created eagerly when a user is first provisioned.
model MatrixAccount {
  id           String   @id @default(cuid())
  iamUserId    String   @unique @map("iam_user_id")    // Kratos identity ID
  matrixUserId String   @unique @map("matrix_user_id") // @user:server
  homeserver   String                                   // matrix.acme.corp
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([iamUserId])
  @@map("matrix_accounts")
}
